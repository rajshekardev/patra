{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "patra",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "frontmatter"
          },
          {
            "type": "SYMBOL",
            "name": "server_block"
          },
          {
            "type": "SYMBOL",
            "name": "client_block"
          },
          {
            "type": "SYMBOL",
            "name": "script_block"
          },
          {
            "type": "SYMBOL",
            "name": "style_block"
          },
          {
            "type": "SYMBOL",
            "name": "document_text"
          }
        ]
      }
    },
    "frontmatter": {
      "type": "SEQ",
      "members": [
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "---\n"
            },
            {
              "type": "STRING",
              "value": "---\r\n"
            }
          ]
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "yaml_content"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "STRING",
              "value": "\n---"
            },
            {
              "type": "STRING",
              "value": "\r\n---"
            }
          ]
        }
      ]
    },
    "yaml_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_content_character"
      }
    },
    "server_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<odin server>"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "odin_content"
          }
        },
        {
          "type": "STRING",
          "value": "</odin>"
        }
      ]
    },
    "client_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<odin client>"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "odin_content"
          }
        },
        {
          "type": "STRING",
          "value": "</odin>"
        }
      ]
    },
    "odin_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_content_character"
      }
    },
    "script_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<script"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "attributes",
              "content": {
                "type": "SYMBOL",
                "name": "tag_attributes"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "script_content"
          }
        },
        {
          "type": "STRING",
          "value": "</script>"
        }
      ]
    },
    "tag_attributes": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 1,
        "content": {
          "type": "PATTERN",
          "value": "[^>]+"
        }
      }
    },
    "script_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_content_character"
      }
    },
    "style_block": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "<style"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "attributes",
              "content": {
                "type": "SYMBOL",
                "name": "tag_attributes"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ">"
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "SYMBOL",
            "name": "css_content"
          }
        },
        {
          "type": "STRING",
          "value": "</style>"
        }
      ]
    },
    "css_content": {
      "type": "REPEAT1",
      "content": {
        "type": "SYMBOL",
        "name": "_content_character"
      }
    },
    "document_text": {
      "type": "PREC_RIGHT",
      "value": 0,
      "content": {
        "type": "REPEAT1",
        "content": {
          "type": "SYMBOL",
          "name": "_content_character"
        }
      }
    },
    "_content_character": {
      "type": "PATTERN",
      "value": "[\\s\\S]"
    }
  },
  "extras": [],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}